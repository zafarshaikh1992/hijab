{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Explicitly hide body when closed */
  #shopify-section-{{ section.id }} details:not([open]) > .collection-desc__body {
    display: none;
  }

  /* Summary row */
  #shopify-section-{{ section.id }} details > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }
  #shopify-section-{{ section.id }} details > summary::-webkit-details-marker { display: none; }

  /* Heading — Cormorant italic, muted */
  #shopify-section-{{ section.id }} details > summary .collection-desc__trigger {
    font-family: var(--font-accent-family, Georgia, serif) !important;
    font-size: clamp(1.8rem, 2.5vw, 2.6rem) !important;
    font-weight: 300 !important;
    font-style: italic !important;
    letter-spacing: 0.01em !important;
    text-transform: none !important;
    color: rgba(0, 0, 0, 0.4) !important;
    margin: 0 !important;
    line-height: 1.3 !important;
  }

  /* +/− indicator */
  #shopify-section-{{ section.id }} details > summary::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 300;
    color: rgba(0, 0, 0, 0.35);
    line-height: 1;
  }
  #shopify-section-{{ section.id }} details[open] > summary::after {
    content: '−';
  }

  /* Body typography */
  #shopify-section-{{ section.id }} .collection-desc__body {
    margin-top: 2.4rem;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .collection-desc__body h2 {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 300;
    letter-spacing: 0.01em;
    color: rgba(0, 0, 0, 0.7);
    margin: 2.4rem 0 0.8rem;
  }
  #shopify-section-{{ section.id }} .collection-desc__body h3 {
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.45);
    margin: 1.6rem 0 0.6rem;
  }
  #shopify-section-{{ section.id }} .collection-desc__body p,
  #shopify-section-{{ section.id }} .collection-desc__body li {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.8;
    color: rgba(0, 0, 0, 0.5);
    margin: 0 0 0.8rem;
  }
  #shopify-section-{{ section.id }} .collection-desc__body ul {
    padding-left: 1.6rem;
  }
  #shopify-section-{{ section.id }} .collection-desc__body strong {
    font-weight: 500;
    color: rgba(0, 0, 0, 0.6);
  }
  #shopify-section-{{ section.id }} .collection-desc__body a {
    color: rgba(0, 0, 0, 0.6);
    text-decoration: underline;
  }
  #shopify-section-{{ section.id }} .collection-desc__guides {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  #shopify-section-{{ section.id }} .collection-desc__guides p {
    font-size: 1.3rem;
    opacity: 0.6;
    margin-bottom: 1rem;
  }
  #shopify-section-{{ section.id }} .collection-desc__guides-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  #shopify-section-{{ section.id }} .collection-desc__guides-links a {
    font-size: 1.3rem;
    text-decoration: underline;
    opacity: 0.8;
  }
{%- endstyle -%}

{%- if collection.description != blank -%}
  <div class="isolate page-width">
    <div class="rich-text content-container color-{{ section.settings.color_scheme }} gradient rich-text--full-width section-{{ section.id }}-padding">
      <div class="rich-text__wrapper rich-text__wrapper--center page-width">
        <div class="rich-text__blocks left">

          <details>
            <summary>
              <h2 class="collection-desc__trigger">{{ collection.title }} — Fabric Guide &amp; Care</h2>
            </summary>

            <div class="collection-desc__body">
              <div class="rte">{{ collection.description }}</div>

              {%- comment -%} Helpful guides — fabric-specific blog links {%- endcomment -%}
              {%- assign related_articles = '' -%}
              {%- if collection.handle contains 'chiffon' -%}
                {%- assign related_articles = '/blogs/hijab-guide/how-to-wash-care-chiffon-hijab|How to Wash & Care for Chiffon,/blogs/hijab-guide/how-to-style-chiffon-hijab-no-slip|How to Style Chiffon (No Slip!)' -%}
              {%- elsif collection.handle contains 'modal' -%}
                {%- assign related_articles = '/blogs/hijab-guide/how-to-wash-care-modal-hijab|How to Wash & Care for Modal,/blogs/hijab-guide/complete-guide-to-hijab|The Complete Hijab Guide' -%}
              {%- elsif collection.handle contains 'bamboo-jersey' -%}
                {%- assign related_articles = '/blogs/hijab-guide/bamboo-jersey-vs-standard-jersey-viscose-hijab-comparison|Why Bamboo Jersey Outlasts Standard Jersey,/blogs/hijab-guide/jersey-hijab-style-guide|Jersey Hijab Style Guide' -%}
              {%- elsif collection.handle contains 'jersey' -%}
                {%- assign related_articles = '/blogs/hijab-guide/jersey-hijab-style-guide|Jersey Hijab Style Guide,/blogs/hijab-guide/bamboo-jersey-vs-standard-jersey-viscose-hijab-comparison|Bamboo Jersey vs Standard Jersey' -%}
              {%- elsif collection.handle contains 'satin' -%}
                {%- assign related_articles = '/blogs/hijab-guide/complete-guide-to-hijab|The Complete Hijab Guide' -%}
              {%- endif -%}

              {%- if related_articles != '' -%}
                {%- assign article_list = related_articles | split: ',' -%}
                <div class="collection-desc__guides">
                  <p>📖 Helpful Guides:</p>
                  <div class="collection-desc__guides-links">
                    {%- for article_link in article_list -%}
                      {%- assign parts = article_link | split: '|' -%}
                      <a href="{{ parts[0] }}">{{ parts[1] }}</a>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </details>

        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection Description",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Collection Description"
    }
  ]
}
{% endschema %}
