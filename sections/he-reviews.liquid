<section class="he-reviews-header color-{{ section.settings.color_scheme }}">
  <div class="he-reviews-header__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="he-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="he-section-heading">
      {{ section.settings.heading_plain }}
      {%- if section.settings.heading_italic != blank -%}
        <em class="he-serif-italic"> {{ section.settings.heading_italic }}</em>
      {%- endif -%}
    </h2>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Heading",
  "tag": "section",
  "class": "section he-reviews-heading-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "CUSTOMER REVIEWS"
    },
    {
      "type": "text",
      "id": "heading_plain",
      "label": "Heading (plain)",
      "default": "What They're"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic)",
      "default": "Saying"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Reviews Heading"
    }
  ]
}
{% endschema %}
