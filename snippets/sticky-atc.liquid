{% comment %}
  ============================================================
  Sticky Add to Cart Bar — Hijab Elegance
  ============================================================
  INSTALLATION:
    1. In Shopify Admin → Online Store → Themes → Edit code
    2. Create a new snippet: snippets/sticky-atc.liquid
       Paste this entire file into it.
    3. Open sections/main-product.liquid (or your theme's
       product section — may be called product-template.liquid
       or product-form.liquid depending on your theme).
    4. Just before the closing {% endcapture %} or at the very
       end of the file, add:
         {% render 'sticky-atc' %}
    5. Save. Done.

  HOW IT WORKS:
    - Observes the main "Add to cart" button on the product page
    - When that button scrolls out of view, the sticky bar
      slides up from the bottom of the screen
    - Bar shows product image, title, selected variant, price,
      and an Add to Cart button
    - Syncs with the main form's variant selection in real time
    - Submits to the same cart form — no duplicate logic
    - Hidden on desktop (≥768px) by default; easy to enable
      for desktop too by removing the media query guard
  ============================================================
{% endcomment %}

{% comment %} Only render on product pages {% endcomment %}
{% if template == 'product' or template contains 'product' %}

<div id="sticky-atc" class="sticky-atc" aria-hidden="true" role="complementary" aria-label="Quick add to cart">
  <div class="sticky-atc__inner">

    {% comment %} Product thumbnail {% endcomment %}
    <div class="sticky-atc__image">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 80, height: 80, crop: 'center' }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="40"
          height="40"
          loading="lazy"
        >
      {% endif %}
    </div>

    {% comment %} Product info {% endcomment %}
    <div class="sticky-atc__info">
      <span class="sticky-atc__title">{{ product.title | truncate: 28 }}</span>
      <span class="sticky-atc__variant" id="sticky-atc-variant">
        {% if product.variants.size > 1 %}
          {{ product.selected_or_first_available_variant.title }}
        {% endif %}
      </span>
    </div>

    {% comment %} Price {% endcomment %}
    <div class="sticky-atc__price" id="sticky-atc-price">
      {% assign current_variant = product.selected_or_first_available_variant %}
      {% if current_variant.compare_at_price > current_variant.price %}
        <span class="sticky-atc__price--sale">{{ current_variant.price | money }}</span>
        <s class="sticky-atc__price--compare">{{ current_variant.compare_at_price | money }}</s>
      {% else %}
        <span>{{ current_variant.price | money }}</span>
      {% endif %}
    </div>

    {% comment %} CTA button {% endcomment %}
    <div class="sticky-atc__cta">
      {% if current_variant.available %}
        <button
          type="button"
          id="sticky-atc-btn"
          class="sticky-atc__btn"
          data-variant-id="{{ current_variant.id }}"
          aria-label="Add {{ product.title | escape }} to bag"
        >
          Add to Bag
        </button>
      {% else %}
        <button
          type="button"
          id="sticky-atc-btn"
          class="sticky-atc__btn sticky-atc__btn--sold-out"
          disabled
          aria-label="Sold out"
        >
          Sold out
        </button>
      {% endif %}
    </div>

  </div>

  {% comment %} Free shipping nudge (shows when cart is below $30) {% endcomment %}
  <div class="sticky-atc__nudge" id="sticky-atc-nudge" aria-live="polite">
    Free shipping on orders over $30
  </div>
</div>

{% endif %}

<style>
  /* ---- Sticky bar ---- */
  .sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background: #fff;
    border-top: 1px solid #e5e5e5;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    /* Safe area for phones with home indicator */
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .sticky-atc.is-visible {
    transform: translateY(0);
  }

  /* Hide on desktop — remove this block to show on all screen sizes */
  @media (min-width: 768px) {
    .sticky-atc {
      display: none;
    }
  }

  .sticky-atc__inner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    max-width: 100%;
  }

  /* Product image */
  .sticky-atc__image {
    flex-shrink: 0;
  }

  .sticky-atc__image img {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid #e5e5e5;
  }

  /* Text info */
  .sticky-atc__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .sticky-atc__title {
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }

  .sticky-atc__variant {
    font-size: 11px;
    color: #757575;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Price */
  .sticky-atc__price {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
    text-align: right;
  }

  .sticky-atc__price--sale {
    color: #c0392b;
  }

  .sticky-atc__price--compare {
    display: block;
    font-size: 11px;
    font-weight: 400;
    color: #999;
  }

  /* CTA button */
  .sticky-atc__cta {
    flex-shrink: 0;
  }

  .sticky-atc__btn {
    background: #b38072;
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 10px 18px;
    font-size: 11px;
    font-family: 'DM Sans', var(--font-heading-family), sans-serif;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s ease, transform 0.1s ease;
    -webkit-tap-highlight-color: transparent;
    min-height: 44px; /* WCAG touch target */
  }

  .sticky-atc__btn:hover {
    background: #9e6e61;
  }

  .sticky-atc__btn:active {
    transform: scale(0.97);
    background: #8a5e52;
  }

  .sticky-atc__btn--sold-out {
    background: #ccc;
    cursor: not-allowed;
  }

  .sticky-atc__btn--loading {
    opacity: 0.7;
    pointer-events: none;
  }

  .sticky-atc__btn--added {
    background: #8a5e52;
  }

  /* Nudge strip */
  .sticky-atc__nudge {
    text-align: center;
    font-size: 11px;
    color: #2a7a4b;
    background: #f0f9f4;
    padding: 5px 14px;
    border-top: 1px solid #d4edda;
    display: none; /* shown via JS when below $30 threshold */
  }

  .sticky-atc__nudge.is-visible {
    display: block;
  }
</style>

<script>
(function () {
  'use strict';

  // ---- Config ----
  var FREE_SHIPPING_CENTS = 3000; // $30.00 in cents — update if you change the threshold

  // ---- Element refs ----
  var bar        = document.getElementById('sticky-atc');
  var stickyBtn  = document.getElementById('sticky-atc-btn');
  var variantEl  = document.getElementById('sticky-atc-variant');
  var priceEl    = document.getElementById('sticky-atc-price');
  var nudgeEl    = document.getElementById('sticky-atc-nudge');

  if (!bar || !stickyBtn) return;

  // ---- Find the main ATC button to observe ----
  // Shopify themes use different selectors — we try the most common ones.
  var mainAtcBtn = (
    document.querySelector('[name="add"]') ||
    document.querySelector('[data-add-to-cart]') ||
    document.querySelector('.product-form__submit') ||
    document.querySelector('.btn--add-to-cart')
  );

  if (!mainAtcBtn) return;

  // ---- Show / hide on scroll ----
  var isVisible = false;

  function handleVisibility(entries) {
    var entry = entries[0];
    // When the main button is NOT intersecting (scrolled out of view), show the bar
    var shouldShow = !entry.isIntersecting;
    if (shouldShow === isVisible) return;
    isVisible = shouldShow;
    bar.classList.toggle('is-visible', shouldShow);
    bar.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
  }

  var observer = new IntersectionObserver(handleVisibility, {
    threshold: 0,
    // Slightly generous rootMargin so bar appears just before button fully leaves
    rootMargin: '0px 0px -60px 0px'
  });

  observer.observe(mainAtcBtn);

  // ---- Sync variant selection from the main product form ----
  // When the shopper selects a size/colour, update the sticky bar's state.
  var currentVariantId  = stickyBtn.dataset.variantId;
  var currentPrice      = null;

  function updateBar(variantId, variantTitle, price, comparePrice, available) {
    currentVariantId = variantId;
    currentPrice     = price;
    // Reset added state when variant changes
    stickyBtn.dataset.added = 'false';
    stickyBtn.classList.remove('sticky-atc__btn--added');
    stickyBtn.textContent = available ? 'Add to Bag' : 'Sold out';

    // Variant label
    if (variantEl) {
      variantEl.textContent = variantTitle && variantTitle !== 'Default Title' ? variantTitle : '';
    }

    // Price
    if (priceEl) {
      if (comparePrice && comparePrice > price) {
        priceEl.innerHTML =
          '<span class="sticky-atc__price--sale">' + formatMoney(price) + '</span>' +
          '<s class="sticky-atc__price--compare">' + formatMoney(comparePrice) + '</s>';
      } else {
        priceEl.innerHTML = '<span>' + formatMoney(price) + '</span>';
      }
    }

    // Button state
    stickyBtn.dataset.variantId = variantId;
    stickyBtn.disabled = !available;
    stickyBtn.textContent = available ? 'Add to Bag' : 'Sold out';
    stickyBtn.classList.toggle('sticky-atc__btn--sold-out', !available);

    // Nudge strip
    updateNudge();
  }

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
  }

  // ---- Free shipping nudge ----
  function updateNudge() {
    // Fetch cart total asynchronously
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        if (!nudgeEl || !currentPrice) return;
        var total    = cart.total_price; // in cents
        var itemPrice = parseInt(currentPrice, 10);
        var needed   = FREE_SHIPPING_CENTS - total - itemPrice;
        if (needed > 0) {
          nudgeEl.textContent = 'Add $' + (needed / 100).toFixed(2) + ' more for free shipping!';
          nudgeEl.classList.add('is-visible');
        } else {
          nudgeEl.classList.remove('is-visible');
        }
      })
      .catch(function() {
        // Silently fail — nudge is a nice-to-have
      });
  }

  // Listen for variant change events fired by the theme
  // Most Shopify themes dispatch one of these events when a variant is selected:
  document.addEventListener('variant:change', function(e) {
    var v = e.detail && (e.detail.variant || e.detail);
    if (!v) return;
    updateBar(v.id, v.title, v.price, v.compare_at_price, v.available);
  });

  // Also listen for the older Shopify "variantChanged" custom event
  document.addEventListener('variantChanged', function(e) {
    var v = e.detail;
    if (!v) return;
    updateBar(v.id, v.title, v.price, v.compare_at_price, v.available);
  });

  // Fallback: watch the hidden variant input that all themes update
  var variantInput = document.querySelector('[name="id"][form]') ||
                     document.querySelector('input[name="id"]');

  if (variantInput) {
    var lastValue = variantInput.value;
    var inputObserver = new MutationObserver(function() {
      if (variantInput.value !== lastValue) {
        lastValue = variantInput.value;
        syncFromVariantId(variantInput.value);
      }
    });
    inputObserver.observe(variantInput, { attributes: true, attributeFilter: ['value'] });

    // Also catch programmatic value changes
    variantInput.addEventListener('change', function() {
      syncFromVariantId(variantInput.value);
    });
  }

  function syncFromVariantId(id) {
    // product.variants is available as a JS object if the theme outputs it.
    // We attempt to find it; if not, gracefully skip.
    var variants = window.__productVariants || (window.theme && window.theme.product && window.theme.product.variants);
    if (!variants) return;
    var variant = variants.find(function(v) { return String(v.id) === String(id); });
    if (!variant) return;
    updateBar(variant.id, variant.title, variant.price, variant.compare_at_price, variant.available);
  }

  // ---- Add to cart action ----
  stickyBtn.addEventListener('click', function () {
  if (!currentVariantId || stickyBtn.disabled) return;

  var btn = stickyBtn;

  // If already added, just open the cart
  if (btn.dataset.added === 'true') {
    // Trigger theme's cart drawer to open
    document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
    // Fallback: navigate to cart page if no drawer
    var cartIcon = document.querySelector('[href="/cart"]');
    if (cartIcon) cartIcon.click();
    return;
  }

  btn.classList.add('sticky-atc__btn--loading');
  btn.textContent = 'Adding…';

  fetch('/cart/add.js', {
    method:  'POST',
    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    body:    JSON.stringify({ id: parseInt(currentVariantId, 10), quantity: 1 })
  })
  .then(function(r) {
    if (!r.ok) throw new Error('Add to cart failed');
    return r.json();
  })
  .then(function() {
    btn.classList.remove('sticky-atc__btn--loading');
    btn.classList.add('sticky-atc__btn--added');
    btn.textContent = '✓ View cart';
    btn.dataset.added = 'true';

    // Trigger theme cart updates
    document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
    document.dispatchEvent(new CustomEvent('cartUpdated',  { bubbles: true }));

    // Update cart count badge
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        var countEls = document.querySelectorAll('[data-cart-count], .cart-count, .header__cart-count');
        countEls.forEach(function(el) { el.textContent = cart.item_count; });
        updateNudge();
      });

    // NO reset timeout — button stays as "✓ View cart"
  })
  .catch(function(err) {
    console.error('[Sticky ATC]', err);
    btn.classList.remove('sticky-atc__btn--loading');
    btn.textContent = 'Add to Bag';
    var form = document.querySelector('form[action="/cart/add"]');
    if (form) form.submit();
  });
});

  // Initial nudge check on page load
  updateNudge();

})();
</script>
